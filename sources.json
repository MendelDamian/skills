[
  {
    "name": "pstack",
    "repo": "cursor/plugins",
    "path": "pstack",
    "exclude": [
      ".cursor-plugin",
      "automations",
      "skills/setup-pstack",
      "skills/recall",
      "skills/reflect",
      "skills/automate-me",
      "skills/make-bot-ui"
