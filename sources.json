  {
    "name": "humanlayer",
    "repo": "humanlayer/skills",
    "paths": [
      { "from": "plugins/show-me/skills/show-me", "to": "skills/show-me" },
      { "from": "plugins/improve-claude-md/skills/improve-claude-md", "to": "skills/improve-claude-md" },
